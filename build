#!/bin/sh
# WHP-Drivers: native WHP LLVM bootstrap and x86 COFF compiler smoke test.
set -eu

root=$(CDPATH= cd "$(dirname "$0")" && pwd)
llvm_root="$root/toolchains/llvm-project"
llvm_src="$llvm_root/llvm"
build_dir=${WHP_LLVM_BUILD_DIR:-"$root/.build/llvm-native"}
bin_dir=${WHP_LLVM_BIN_DIR:-"$build_dir/bin"}
water_root="$root/third_party/water"
water_inc="$water_root/include"

die() {
    printf '%s\n' "WHP-Drivers: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing required program: $1"
}

# Shared WHP Windows 95 RTM headers are owned by the pinned Water gitlink.
# Fail closed: never silently fall back to host, NT/WDM, or moving master headers.
check_water_revision() {
    need git
    pinned=$(git -C "$root" rev-parse HEAD:third_party/water 2>/dev/null) ||
        die "cannot read pinned Water revision"
    actual=$(git -C "$water_root" rev-parse HEAD 2>/dev/null) ||
        die "cannot read Water checkout revision"
    [ "$pinned" = "$actual" ] ||
        die "Water checkout differs from pinned revision ($actual != $pinned)"
}

check_water_headers() {
    check_water_revision
    for hdr in ddk/win95rtm/vmm.h \
               ddk/win95rtm/win16_abi.h \
               ddk/win95rtm/audio/ddk_audio.h \
               ddk/win95rtm/display/ddk_minidrv.h \
               ddk/win95rtm/display/minivdd.h; do
        [ -f "$water_inc/$hdr" ] ||
            die "missing Water Win95 RTM header $hdr; git submodule update --init third_party/water"
    done
}

check_source() {
    need git
    [ -f "$llvm_src/CMakeLists.txt" ] ||
        die "missing LLVM submodule: git submodule update --init toolchains/llvm-project"
    pinned=$(git -C "$root" rev-parse HEAD:toolchains/llvm-project 2>/dev/null) ||
        die "cannot read pinned LLVM revision"
    actual=$(git -C "$llvm_root" rev-parse HEAD 2>/dev/null) ||
        die "cannot read LLVM checkout revision"
    [ "$pinned" = "$actual" ] ||
        die "LLVM checkout differs from pinned revision ($actual != $pinned)"
}

check_tools() {
    check_source
    for tool in clang clang++ lld-link llvm-ar llvm-nm llvm-ranlib \
                llvm-objcopy llvm-objdump llvm-readobj llvm-strip
    do
        [ -x "$bin_dir/$tool" ] ||
            die "missing $bin_dir/$tool (run ./build bootstrap or set WHP_LLVM_BIN_DIR)"
    done
    "$bin_dir/clang" --version
}

bootstrap() {
    check_source
    need cmake
    need ninja
    jobs=${WHP_LLVM_JOBS:-2}
    case "$jobs" in
        ''|0|*[!0-9]*) die "WHP_LLVM_JOBS must be a positive integer" ;;
    esac
    cmake -S "$llvm_src" -B "$build_dir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        '-DLLVM_ENABLE_PROJECTS=clang;lld' \
        -DLLVM_TARGETS_TO_BUILD=X86 \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_BENCHMARKS=OFF
    cmake --build "$build_dir" --parallel "$jobs" --target \
        clang lld llvm-ar llvm-nm llvm-ranlib llvm-objcopy \
        llvm-objdump llvm-readobj llvm-strip
    bin_dir="$build_dir/bin"
    check_tools
}

smoke() {
    check_tools
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    "$bin_dir/clang" --target=i386-pc-windows-msvc \
        -std=c11 -ffreestanding -fno-builtin -fno-stack-protector \
        -Wall -Wextra -Werror -c \
        "$root/tests/i386-abi-probe.c" -o "$out_dir/i386-abi-probe.obj"
    "$bin_dir/llvm-readobj" --file-headers "$out_dir/i386-abi-probe.obj" |
        grep -q 'Machine: IMAGE_FILE_MACHINE_I386' ||
        die "COFF i386 machine-type verification failed"
    printf '%s\n' "WHP-Drivers: i386 Windows COFF compiler smoke test passed"
}


test_le() {
    check_source
    need python3
    python3 -m unittest discover -s "$llvm_root/lld/utils/whp-le" -p 'test_link.py'
}

smoke_vxd() {
    check_tools
    check_water_headers
    need python3
    writer="$llvm_root/lld/utils/whp-le-link.py"
    [ -f "$writer" ] || die "pinned LLVM lacks experimental LE writer"
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    "$bin_dir/clang" --target=i386-pc-windows-msvc \
        -std=c11 -ffreestanding -fno-builtin -fno-stack-protector \
        -Wall -Wextra -Werror -I"$root/include" -I"$water_inc" -c \
        "$root/tests/whp-vxd-probe.c" -o "$out_dir/whp-vxd-probe.obj"
    python3 "$writer" --name WHPTEST --ddb WHPTEST_DDB \
        -o "$out_dir/WHPTEST.VXD" "$out_dir/whp-vxd-probe.obj"
    python3 "$root/tools/verify_vxd.py" --dynamic "$out_dir/WHPTEST.VXD"
    printf '%s\n' "WHP-Drivers: LE format smoke test passed (Windows 95 runtime NOT tested)"
}


# The OpenWatcom path is explicitly opt-in; the LLVM backend remains primary.
# A working macOS *host* compiler does not establish VxD LE-linker correctness.
watcom_src="$root/toolchains/openwatcom"
watcom_root=${WHP_WATCOM_ROOT:-"$watcom_src/rel"}
watcom_bin_dir=${WHP_WATCOM_BIN_DIR:-}

check_watcom_source() {
    need git
    [ -f "$watcom_src/build.sh" ] ||
        die "missing pinned OpenWatcom source: git submodule update --init toolchains/openwatcom"
    pinned=$(git -C "$root" rev-parse HEAD:toolchains/openwatcom 2>/dev/null) ||
        die "cannot read pinned OpenWatcom revision"
    actual=$(git -C "$watcom_src" rev-parse HEAD 2>/dev/null) ||
        die "cannot read OpenWatcom checkout revision"
    [ "$pinned" = "$actual" ] ||
        die "OpenWatcom checkout differs from pinned revision ($actual != $pinned)"
}

watcom_check() {
    check_watcom_source
    if [ -z "$watcom_bin_dir" ]; then
        platform=$(uname -s)
        arch=$(uname -m)
        case "$platform:$arch" in
            Darwin:arm64|Darwin:aarch64) host_dir=armo64 ;;
            Darwin:x86_64) host_dir=bino64 ;;
            Linux:x86_64) host_dir=binl64 ;;
            Linux:aarch64|Linux:arm64) host_dir=arml64 ;;
            *) die "unsupported OpenWatcom native host $platform/$arch; set WHP_WATCOM_BIN_DIR explicitly" ;;
        esac
        watcom_bin_dir="$watcom_root/$host_dir"
    fi
    [ -d "$watcom_root/h" ] ||
        die "missing OpenWatcom release headers at $watcom_root/h; build/install the pinned fork"
    [ -x "$watcom_bin_dir/wcc386" ] ||
        die "missing native OpenWatcom compiler $watcom_bin_dir/wcc386"
    [ -x "$watcom_bin_dir/wlink" ] ||
        die "missing native OpenWatcom linker $watcom_bin_dir/wlink"
    printf '%s\n' "WHP-Drivers: OpenWatcom candidate found ($watcom_bin_dir); VxD capability NOT verified"
}

watcom_smoke_vxd() {
    watcom_check
    need python3
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    obj="$out_dir/whp-watcom-vxd-probe.obj"
    vxd="$out_dir/WHPWAT.VXD"
    # Use OpenWatcom objects with its own linker; never silently mix in LLVM COFF.
    # -bt=nt chooses a 32-bit Windows code-generation target, NOT an NT .SYS ABI.
    (
        export WATCOM="$watcom_root"
        export INCLUDE="$watcom_root/h"
        "$watcom_bin_dir/wcc386" -zq -s -bt=nt "-fo=$obj" \
            "$root/tests/watcom-vxd-probe.c"
    ) || die "OpenWatcom x86 compile failed"
    rm -f "$vxd"
    (
        export WATCOM="$watcom_root"
        "$watcom_bin_dir/wlink" "format windows vxd dynamic" \
            "option nodefaultlibs" "file $obj" "name $vxd" \
            "export WHPWAT_DDB.1"
    ) || die "OpenWatcom Windows VxD linking failed (no fallback activated)"
    [ -f "$vxd" ] ||
        die "OpenWatcom reported success but produced no VxD"
    python3 "$root/tools/verify_vxd.py" --dynamic "$vxd" ||
        die "OpenWatcom output rejected by LE verifier (no fallback activated)"
    printf '%s\n' "WHP-Drivers: OpenWatcom LE format probe passed; Win95 RTM loading NOT verified"
}

smoke_radeon6410d() {
    check_tools
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    gpu_dir="$root/drivers/display/radeon_hd_6410d"
    "$bin_dir/clang" --target=i386-pc-windows-msvc \
        -std=c11 -ffreestanding -fno-builtin -fno-stack-protector \
        -Wall -Wextra -Werror -I"$gpu_dir" -c \
        "$gpu_dir/pci_id.c" -o "$out_dir/radeon6410d-pci-id.obj"
    "$bin_dir/llvm-readobj" --file-headers "$out_dir/radeon6410d-pci-id.obj" |
        grep -q 'Machine: IMAGE_FILE_MACHINE_I386' ||
        die "Radeon HD 6410D object is not i386 COFF"
    "$bin_dir/clang" -std=c11 -Wall -Wextra -Werror -I"$gpu_dir" \
        "$gpu_dir/pci_id.c" "$root/tests/radeon6410d-pci-id.c" \
        -o "$out_dir/radeon6410d-pci-id-host-test"
    "$out_dir/radeon6410d-pci-id-host-test" ||
        die "Radeon HD 6410D PCI identity tests failed"
    # Pure EDID/DDC data interpretation: no PCI reads, I2C, or modesetting.
    "$bin_dir/clang" --target=i386-pc-windows-msvc \
        -std=c11 -ffreestanding -fno-builtin -fno-stack-protector \
        -Wall -Wextra -Werror -I"$gpu_dir" -c \
        "$gpu_dir/dvi_edid.c" -o "$out_dir/radeon6410d-dvi-edid.obj"
    "$bin_dir/llvm-readobj" --file-headers "$out_dir/radeon6410d-dvi-edid.obj" |
        grep -q 'Machine: IMAGE_FILE_MACHINE_I386' ||
        die "Radeon HD 6410D DVI EDID object is not i386 COFF"
    "$bin_dir/clang" -std=c11 -Wall -Wextra -Werror -I"$gpu_dir" \
        "$gpu_dir/dvi_edid.c" "$root/tests/radeon6410d-dvi-edid.c" \
        -o "$out_dir/radeon6410d-dvi-edid-host-test"
    "$out_dir/radeon6410d-dvi-edid-host-test" ||
        die "Radeon HD 6410D EDID parser regression tests failed"
    printf '%s\n' "WHP-Drivers: Radeon HD 6410D PCI + EDID smoke passed (no DDC or GPU accessed)"
}

# Realtek RTL8111E: data-only PCI/XID/MAC checks, no hardware operations.
smoke_rtl8111e() {
    check_tools
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    nic_dir="$root/drivers/network/rtl8111e"
    "$bin_dir/clang" --target=i386-pc-windows-msvc \
        -std=c11 -ffreestanding -fno-builtin -fno-stack-protector \
        -Wall -Wextra -Werror -I"$nic_dir" -c \
        "$nic_dir/identity.c" -o "$out_dir/rtl8111e-identity.obj"
    "$bin_dir/llvm-readobj" --file-headers "$out_dir/rtl8111e-identity.obj" |
        grep -q 'Machine: IMAGE_FILE_MACHINE_I386' ||
        die "RTL8111E identity object is not i386 COFF"
    "$bin_dir/clang" -std=c11 -Wall -Wextra -Werror -I"$nic_dir" \
        "$nic_dir/identity.c" "$root/tests/rtl8111e-identity.c" \
        -o "$out_dir/rtl8111e-identity-host-test"
    "$out_dir/rtl8111e-identity-host-test" ||
        die "RTL8111E identity tests failed"
    # Host-only miniport state/queue accounting: no NDIS, MMIO, IRQ or DMA.
    "$bin_dir/clang" --target=i386-pc-windows-msvc \
        -std=c11 -ffreestanding -fno-builtin -fno-stack-protector \
        -Wall -Wextra -Werror -I"$nic_dir" -c \
        "$nic_dir/miniport_core.c" -o "$out_dir/rtl8111e-miniport-core.obj"
    "$bin_dir/llvm-readobj" --file-headers "$out_dir/rtl8111e-miniport-core.obj" |
        grep -q 'Machine: IMAGE_FILE_MACHINE_I386' ||
        die "RTL8111E miniport core is not i386 COFF"
    "$bin_dir/clang" -std=c11 -Wall -Wextra -Werror -I"$nic_dir" \
        "$nic_dir/identity.c" "$nic_dir/miniport_core.c" \
        "$root/tests/rtl8111e-miniport-core.c" \
        -o "$out_dir/rtl8111e-miniport-host-test"
    "$out_dir/rtl8111e-miniport-host-test" ||
        die "RTL8111E miniport lifecycle tests failed"
    printf '%s\n' "WHP-Drivers: RTL8111E identity + miniport policy smoke passed (not loadable)"

}

# Build the pinned OpenWatcom fork as a native host toolchain, independent
# of any Windows 95 VxD linkage or driver selection.
bootstrap_watcom() {
    check_watcom_source
    need make
    [ -f "$watcom_src/ci/buildx.sh" ] ||
        die "pinned OpenWatcom source lacks ci/buildx.sh"
    [ -f "$watcom_src/cmnvars.sh" ] ||
        die "pinned OpenWatcom source lacks cmnvars.sh"
    [ "$watcom_root" = "$watcom_src/rel" ] ||
        die "OpenWatcom bootstrap writes to the pinned source rel/ tree; unset WHP_WATCOM_ROOT"
    [ -z "${WHP_WATCOM_BIN_DIR:-}" ] ||
        die "OpenWatcom bootstrap uses pinned rel/ binaries; unset WHP_WATCOM_BIN_DIR"
    case "$(uname -s)" in
        Darwin|Linux) ;;
        *) die "OpenWatcom bootstrap only wired for macOS/Linux hosts" ;;
    esac

    # Explicit compiler > built WHP LLVM > announced host clang fallback.
    if [ -n "${WHP_WATCOM_CLANG:-}" ]; then
        clang_host=$WHP_WATCOM_CLANG
        printf '%s\n' "WHP-Drivers: explicit OpenWatcom host Clang: $clang_host"
    elif [ -x "$bin_dir/clang" ]; then
        check_source
        clang_host="$bin_dir/clang"
        printf '%s\n' "WHP-Drivers: using pinned WHP LLVM to bootstrap OpenWatcom"
    else
        clang_host=$(command -v clang) || die "OpenWatcom bootstrap requires host clang or WHP LLVM"
        printf '%s\n' "WHP-Drivers: pinned WHP LLVM not built; using host Clang: $clang_host"
    fi
    clang_host=$(command -v "$clang_host") ||
        die "cannot find OpenWatcom host compiler $clang_host"
    case "$clang_host" in
        /*) ;;
        *) die "OpenWatcom host compiler must resolve to an absolute path: $clang_host" ;;
    esac
    [ -x "$clang_host" ] ||
        die "OpenWatcom host compiler is not executable: $clang_host"
    case "$clang_host" in
        *' '*|*'='*) die "OpenWatcom upstream build cannot safely handle spaces or '=' in compiler paths" ;;
    esac
    case "$watcom_src" in
        *' '*|*'='*) die "OpenWatcom upstream build cannot safely handle spaces or '=' in source paths" ;;
    esac
    (
        cd "$watcom_src"
        OWROOT="$watcom_src"
        OWRELROOT="$watcom_src/rel"
        OWTOOLS=CLANG
        OWCLANG="$clang_host"
        PATH="${clang_host%/*}:$PATH"
        OWOBJDIR=binbuild
        OWDOCBUILD=0
        OWNOWGML=1
        OWGUINOBUILD=1
        export PATH OWROOT OWRELROOT OWTOOLS OWCLANG OWOBJDIR OWDOCBUILD OWNOWGML OWGUINOBUILD
        # Do not source setvars.sh: it unconditionally overrides OWTOOLS=GCC.
        # ci/buildx.sh sources cmnvars.sh like upstream macOS CI.
        printf '%s\n' "WHP-Drivers: OpenWatcom stage 1/2 (native bootstrap tools)"
        OWBUILD_STAGE=boot
        export OWBUILD_STAGE
        sh ./ci/buildx.sh ||
            die "OpenWatcom native bootstrap stage failed"
        printf '%s\n' "WHP-Drivers: OpenWatcom stage 2/2 (release compiler and linker)"
        OWBUILD_STAGE=build
        export OWBUILD_STAGE
        sh ./ci/buildx.sh ||
            die "OpenWatcom release build failed"
    )
    watcom_check
    printf '%s\n' "WHP-Drivers: native OpenWatcom toolchain built; Windows 95 VxD loading NOT verified"
}

# A Win16 display .DRV is NOT an i386/32-bit COFF VxD. Keep its
# memory model, DDK include path, and compiler separate from LLVM.
win16_display_check() {
    watcom_check
    check_water_headers
    [ -x "$watcom_bin_dir/wcc" ] ||
        die "OpenWatcom Win16 compiler missing: $watcom_bin_dir/wcc"
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    # Compile-only: inspect the Win16 ABI without creating/installing a DRV.
    (
        export WATCOM="$watcom_root"
        export INCLUDE="$watcom_root/h:$watcom_root/h/win:$root/include:$water_inc"
        "$watcom_bin_dir/wcc" -zq -bt=windows -mc -bd -zu -c \
            "-fo=$out_dir/win95-display-win16-abi.obj" \
            "$root/tests/win95-display-win16-abi.c"
    ) || die "Windows 95 Win16 display ABI probe compilation failed"
    [ -s "$out_dir/win95-display-win16-abi.obj" ] ||
        die "Win16 ABI compiler did not produce an object"
    printf '%s\n' "WHP-Drivers: Win16 display ABI object compiled (not a loadable driver)"
}

win16_display_ddk_check() {
    watcom_check
    check_water_headers
    [ -x "$watcom_bin_dir/wcc" ] ||
        die "OpenWatcom Win16 compiler missing: $watcom_bin_dir/wcc"
    ddk_dir=${WHP_WIN95_DISPLAY_DDK_INCLUDE:-}
    [ -n "$ddk_dir" ] ||
        die "set WHP_WIN95_DISPLAY_DDK_INCLUDE to an independently verified Win95 display DDK include directory"
    [ -d "$ddk_dir" ] || die "Win95 display DDK include directory not found: $ddk_dir"
    for hdr in gdidefs.h dibeng.h; do
        [ -f "$ddk_dir/$hdr" ] ||
            die "historical Win95 display DDK header missing: $ddk_dir/$hdr"
    done
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    (
        export WATCOM="$watcom_root"
        export INCLUDE="$ddk_dir:$watcom_root/h:$watcom_root/h/win:$root/include:$water_inc"
        "$watcom_bin_dir/wcc" -zq -bt=windows -mc -bd -zu -c \
            -dWHP_WIN95_DISPLAY_USE_HISTORICAL_DDK \
            "-fo=$out_dir/win95-display-ddk-abi.obj" \
            "$root/tests/win95-display-win16-abi.c"
    ) || die "Win95 historical display DDK compatibility probe failed (do not substitute NT/WDM headers)"
    [ -s "$out_dir/win95-display-ddk-abi.obj" ] ||
        die "Win95 DDK compiler did not produce an object"
    printf '%s\n' "WHP-Drivers: historical display DDK headers compiled; DIBENG ABI and RTM guest loading unverified"
}

# Win95 RTM audio drivers use a Win16 NE interface distinct from Win9x VxDs.
# Reuse the same genuine 16-bit compiler/segmented memory model as display.
win16_audio_check() {
    watcom_check
    check_water_headers
    [ -x "$watcom_bin_dir/wcc" ] ||
        die "OpenWatcom Win16 compiler missing: $watcom_bin_dir/wcc"
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    (
        export WATCOM="$watcom_root"
        export INCLUDE="$watcom_root/h:$watcom_root/h/win:$root/include:$water_inc"
        "$watcom_bin_dir/wcc" -zq -bt=windows -mc -bd -zu -c \
            "-fo=$out_dir/win95-audio-win16-abi.obj" \
            "$root/tests/win95-audio-win16-abi.c"
    ) || die "Win95 Win16 audio ABI probe compilation failed"
    [ -s "$out_dir/win95-audio-win16-abi.obj" ] ||
        die "Win16 audio ABI compiler did not produce an object"
    printf '%s\n' "WHP-Drivers: Win16 audio ABI object compiled (not a sound driver)"
}

win16_audio_ddk_check() {
    watcom_check
    check_water_headers
    [ -x "$watcom_bin_dir/wcc" ] ||
        die "OpenWatcom Win16 compiler missing: $watcom_bin_dir/wcc"
    ddk_dir=${WHP_WIN95_AUDIO_DDK_INCLUDE:-}
    [ -n "$ddk_dir" ] ||
        die "set WHP_WIN95_AUDIO_DDK_INCLUDE to a verified Win95 multimedia DDK include directory"
    [ -d "$ddk_dir" ] || die "Win95 audio DDK directory missing: $ddk_dir"
    for hdr in mmsystem.h mmddk.h; do
        [ -f "$ddk_dir/$hdr" ] ||
            die "Win95 audio DDK header missing: $ddk_dir/$hdr (do not use Water's generic Win32 header)"
    done
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    (
        export WATCOM="$watcom_root"
        export INCLUDE="$ddk_dir:$watcom_root/h:$watcom_root/h/win:$root/include:$water_inc"
        "$watcom_bin_dir/wcc" -zq -bt=windows -mc -bd -zu -c \
            -dWHP_WIN95_AUDIO_USE_HISTORICAL_DDK \
            "-fo=$out_dir/win95-audio-ddk-abi.obj" \
            "$root/tests/win95-audio-win16-abi.c"
    ) || die "Win95 audio DDK Win16 probe failed (no NT/WDM or 32-bit mmddk fallback)"
    [ -s "$out_dir/win95-audio-ddk-abi.obj" ] ||
        die "Win95 audio DDK Win16 compiler did not produce an object"
    printf '%s\n' "WHP-Drivers: Win95 audio DDK Win16 header probe compiled (NE driver/hardware unverified)"
}
# Inspect a local DDK candidate without touching compiler, hardware or repo pins.
ndis31_ddk_inventory() {
    need python3
    ddk_dir=${WHP_WIN95_NDIS31_DDK_INCLUDE:-}
    [ -n "$ddk_dir" ] ||
        die "set WHP_WIN95_NDIS31_DDK_INCLUDE to a candidate NT 3.51 DDK include path"
    python3 "$root/tools/audit_ndis31_ddk.py" inspect "$ddk_dir" ||
        die "DDK candidate inventory failed"
}

ndis31_ddk_audit_test() {
    need python3
    cd "$root"
    exec python3 -m unittest discover -s tests -p 'test_ndis31_ddk_audit.py'
}

# NDIS 3.1 miniport header compile-only probe: NT 3.51 DDK, never
# silently substitute Water's newer include/ddk/ndis.h or NT/WDM SDK.
ndis31_ddk_check() {
    watcom_check
    check_water_revision
    [ -f "$water_inc/ddk/win95rtm/network/ndis31.h" ] ||
        die "missing pinned Water Win95 NDIS 3.1 boundary header"
    [ -x "$watcom_bin_dir/wcc386" ] ||
        die "OpenWatcom 32-bit compiler missing: $watcom_bin_dir/wcc386"
    ddk_dir=${WHP_WIN95_NDIS31_DDK_INCLUDE:-}
    [ -n "$ddk_dir" ] ||
        die "set WHP_WIN95_NDIS31_DDK_INCLUDE to verified NT 3.51 DDK headers"
    [ -d "$ddk_dir" ] || die "NT 3.51 DDK include directory missing: $ddk_dir"
    for hdr in ndis.h ntddk.h; do
        [ -f "$ddk_dir/$hdr" ] ||
            die "NT 3.51 DDK file missing: $ddk_dir/$hdr (no modern fallback)"
    done
    # Byte identity is necessary for reproducibility but NOT DDK provenance.
    # The owner must independently establish which historical kit supplied
    # these bytes before recording the expected checksums.
    ndis_sha=${WHP_NT351_DDK_NDIS_SHA256:-}
    ntddk_sha=${WHP_NT351_DDK_NTDDK_SHA256:-}
    [ -n "$ndis_sha" ] && [ -n "$ntddk_sha" ] ||
        die "provide BOTH WHP_NT351_DDK_NDIS_SHA256 and WHP_NT351_DDK_NTDDK_SHA256"
    python3 "$root/tools/audit_ndis31_ddk.py" verify "$ddk_dir" \
        --ndis-sha256 "$ndis_sha" --ntddk-sha256 "$ntddk_sha" ||
        die "NT 3.51 DDK fingerprint or NDIS-generation preflight failed"
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    (
        export WATCOM="$watcom_root"
        export INCLUDE="$ddk_dir:$watcom_root/h:$watcom_root/h/nt:$root/include:$water_inc"
        "$watcom_bin_dir/wcc386" -zq -s -bt=nt -c \
            -dWHP_WIN95_NDIS31_USE_HISTORICAL_DDK \
            "-fo=$out_dir/win95-ndis31-header.obj" \
            "$root/tests/win95-ndis31-header.c"
    ) || die "NT 3.51 NDIS 3.1 miniport header probe failed"
    [ -s "$out_dir/win95-ndis31-header.obj" ] ||
        die "NT 3.51 NDIS header probe did not create an object"
    printf '%s\n' "WHP-Drivers: NDIS 3.1 header probe compiled; Win95 LE/VxD not tested"
}
# A read-only i386 COFF compile check of our MINIVDD.H C boundary.
# The Win16 display check separately compiles the same header with wcc.
minivdd_header_check() {
    check_tools
    check_water_headers
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    "$bin_dir/clang" --target=i386-pc-windows-msvc \
        -std=c11 -ffreestanding -fno-builtin -fno-stack-protector \
        -Wall -Wextra -Werror -I"$root/include" -I"$water_inc" -c \
        "$root/tests/win95-minivdd-header.c" \
        -o "$out_dir/win95-minivdd-header.obj"
    "$bin_dir/llvm-readobj" --file-headers "$out_dir/win95-minivdd-header.obj" |
        grep -q 'Machine: IMAGE_FILE_MACHINE_I386' ||
        die "MINIVDD.H ABI probe was not i386 COFF"
    printf '%s\n' "WHP-Drivers: mini-VDD C header check passed (Win95 RTM guest ABI NOT verified)"
}

# Standalone Win95 INF preflight (no toolchain, guest, or GPU required).
radeon_inf_check() {
    need python3
    python3 "$root/tools/verify_radeon_inf.py" ||
        die "Radeon Win95 INF safety verification failed"
    python3 -m unittest discover -s "$root/tests" -p 'test_radeon_inf.py' ||
        die "Radeon Win95 INF fail-closed regressions failed"
}


case "${1:-}" in
    minivdd-check) minivdd_header_check ;;
    display-win16-check) win16_display_check ;;
    display-ddk-check) win16_display_ddk_check ;;
    audio-win16-check) win16_audio_check ;;
    audio-ddk-check) win16_audio_ddk_check ;;
    ndis31-ddk-check) ndis31_ddk_check ;;
    ndis31-ddk-inventory) ndis31_ddk_inventory ;;
    test-ndis31-audit) ndis31_ddk_audit_test ;;
    bootstrap-watcom) bootstrap_watcom ;;
    watcom-check) watcom_check ;;
    watcom-smoke-vxd) watcom_smoke_vxd ;;
    bootstrap) bootstrap ;;
    check) check_tools ;;
    smoke) smoke ;;
    test-le) test_le ;;
    smoke-vxd) smoke_vxd ;;
    smoke-radeon6410d) smoke_radeon6410d ;;
    smoke-rtl8111e) smoke_rtl8111e ;;
    inf-check) radeon_inf_check ;;
    verify-vxd)
        [ "$#" -eq 2 ] || die "usage: ./build verify-vxd <file.vxd>"
        need python3
        exec python3 "$root/tools/verify_vxd.py" --dynamic "$2"
        ;;
    test-format)
        [ "$#" -eq 1 ] || die "usage: ./build test-format"
        need python3
        cd "$root"
        exec python3 -m unittest discover -s tests -p 'test_vxd_format.py'
        ;;
    *) printf 'Usage: %s {bootstrap|bootstrap-watcom|display-win16-check|display-ddk-check|audio-win16-check|audio-ddk-check|ndis31-ddk-check|ndis31-ddk-inventory|test-ndis31-audit|minivdd-check|check|smoke|smoke-vxd|smoke-radeon6410d|smoke-rtl8111e|inf-check|watcom-check|watcom-smoke-vxd|test-le|verify-vxd <file>|test-format}\n' "$0" >&2; exit 2 ;;
esac
