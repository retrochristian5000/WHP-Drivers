# Brother MFC-290C: host-only USB device identity, not a functional driver.
test_brother_mfc290c() {
    need cc
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    cc -std=c11 -Wall -Wextra -Werror -Wpedantic \
        -I"$root/drivers/usb/brother" \
        "$root/drivers/usb/brother/mfc290c.c" \
        "$root/tests/brother-mfc290c.c" \
        -o "$out_dir/brother-mfc290c-host-test" ||
        die "MFC-290C USB identity test compilation failed"
    "$out_dir/brother-mfc290c-host-test" ||
        die "MFC-290C synthetic USB identity checks failed"
    cc -std=c11 -Wall -Wextra -Werror -Wpedantic \
        -I"$root/drivers/usb/brother" \
        "$root/drivers/usb/brother/mfc290c_model_match.c" \
        "$root/tests/brother-mfc290c-model.c" \
        -o "$out_dir/brother-mfc290c-model-host-test" ||
        die "MFC-290C CUPS model-label test compilation failed"
    "$out_dir/brother-mfc290c-model-host-test" ||
        die "MFC-290C synthetic CUPS model-label checks failed"
    cc -std=c11 -Wall -Wextra -Werror -Wpedantic \
        -I"$root/drivers/usb/brother" \
        "$root/drivers/usb/brother/mfc290c_location.c" \
        "$root/drivers/usb/brother/mfc290c.c" \
        "$root/tests/brother-mfc290c-location.c" \
        -o "$out_dir/brother-mfc290c-location-host-test" ||
        die "MFC-290C USB location-hint regression compilation failed"
    "$out_dir/brother-mfc290c-location-host-test" ||
        die "MFC-290C USB location-hint regression failed"
    cc -std=c11 -Wall -Wextra -Werror -Wpedantic \
        -I"$root/drivers/usb/brother" \
        "$root/drivers/usb/brother/mfc290c_fax.c" \
        "$root/drivers/usb/brother/mfc290c.c" \
        "$root/tests/brother-mfc290c-fax.c" \
        -o "$out_dir/brother-mfc290c-fax-host-test" ||
        die "MFC-290C fax capability regression compilation failed"
    "$out_dir/brother-mfc290c-fax-host-test" ||
        die "MFC-290C fax capability and policy regression failed"
    cc -std=c11 -Wall -Wextra -Werror -Wpedantic \
        -I"$root/drivers/usb/brother" \
        "$root/drivers/usb/brother/mfc290c_usb_commands.c" \
        "$root/tests/brother-mfc290c-usb-commands.c" \
        -o "$out_dir/brother-mfc290c-usb-commands-host-test" ||
        die "MFC-290C offline USB command analysis compilation failed"
    "$out_dir/brother-mfc290c-usb-commands-host-test" ||
        die "MFC-290C offline USB command regression failed"
    test_probe_scope
}

# macOS has an independent USB-device observation path; no DOS/Win95 ABI.
# Build only on a native Mac with the Apple Command Line Tools installed.
build_brother_mfc290c_macos() {
    [ "$(uname -s)" = Darwin ] ||
        die 'MFC-290C IOKit probe requires a native macOS build host'
    compiler=${CC:-cc}
    command -v "$compiler" >/dev/null 2>&1 ||
        die "missing macOS host C compiler: $compiler"
    # Select Mach-O slices without changing USB commands or the SDK.
    arch_mode=${WHP_MFC290C_MACOS_ARCH:-native}
    case "$arch_mode" in
        native) set -- ;;
        arm64|x86_64) set -- -arch "$arch_mode" ;;
        universal2) set -- -arch arm64 -arch x86_64 ;;
        *) die 'WHP_MFC290C_MACOS_ARCH must be native, arm64, x86_64 or universal2 (not arm64e)' ;;
    esac
    need lipo
    out_dir="$root/.build/brother-mfc290c-macos"
    [ ! -L "$root/.build" ] && [ ! -L "$out_dir" ] &&
        [ ! -L "$out_dir/mfc290c-probe" ] &&
        [ ! -L "$out_dir/whp-system-probe" ] ||
        die 'MFC-290C build refuses symlinked output paths'
    [ ! -e "$root/.build" ] || [ -d "$root/.build" ] ||
        die 'MFC-290C build output parent is not a directory'
    (
        umask 077
        mkdir -p "$out_dir" || exit 1
        chmod 700 "$out_dir" || exit 1
        "$compiler" "$@" -std=c11 -Wall -Wextra -Werror -Wpedantic \
            -I"$root/drivers/usb/brother" \
            "$root/tools/probe/probe_scope.c" \
            "$root/tools/macos/mfc290c_probe.c" \
            "$root/tools/macos/mfc290c_cups.c" \
            "$root/drivers/usb/brother/mfc290c_model_match.c" \
            "$root/drivers/usb/brother/mfc290c_location.c" \
            "$root/drivers/usb/brother/mfc290c_usb_commands.c" \
            -framework IOKit -framework CoreFoundation -lcups \
            -o "$out_dir/mfc290c-probe" || exit 1
        "$compiler" "$@" -std=c11 -Wall -Wextra -Werror -Wpedantic \
            "$root/tools/probe/probe_scope.c" \
            "$root/tools/macos/whp_system_probe.c" \
            -framework IOKit -framework CoreFoundation \
            -o "$out_dir/whp-system-probe" || exit 1
    ) || die 'macOS native probe builds failed'
    slices=$(lipo -archs "$out_dir/mfc290c-probe") ||
        die 'cannot inspect MFC-290C Mach-O architecture'
    case "$arch_mode" in
        native)
            case "$slices" in
                arm64|x86_64) ;;
                *) die "unexpected native macOS probe slices: $slices" ;;
            esac ;;
        arm64|x86_64)
            [ "$slices" = "$arch_mode" ] ||
                die "macOS probe architecture mismatch ($arch_mode vs $slices)" ;;
        universal2)
            case "$slices" in
                'arm64 x86_64'|'x86_64 arm64') ;;
                *) die "universal2 requires exactly arm64 and x86_64: $slices" ;;
            esac ;;
    esac
    system_slices=$(lipo -archs "$out_dir/whp-system-probe") ||
        die "cannot inspect macOS system probe architecture"
    [ "$system_slices" = "$slices" ] ||
        die "macOS system/probe slice mismatch ($system_slices vs $slices)"
    printf '%s\n' "WHP-Drivers: macOS probe Mach-O slices=$slices ($arch_mode)"
    printf '%s\n' "WHP-Drivers: macOS USB inventory tool built at $out_dir/mfc290c-probe"
    printf '%s\n' "WHP-Drivers: macOS native system inventory at $out_dir/whp-system-probe"
}

probe_brother_mfc290c_macos() {
    build_brother_mfc290c_macos
    "$root/.build/brother-mfc290c-macos/mfc290c-probe" "$@" ||
        die 'MFC-290C macOS IOKit observation failed'
}

