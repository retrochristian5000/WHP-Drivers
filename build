    cc -std=c11 -Wall -Wextra -Werror \
        -I"$root/drivers/bus/pci95" \
        "$root/drivers/bus/pci95/pci_bios_read.c" \
        "$root/drivers/bus/pci95/pci_bridge.c" \
        "$root/tests/pci95-bios-read.c" \
        -o "$out_dir/pci95-bios-read-host-test" ||
        die "PCI95 BIOS transport host compilation failed"
    "$out_dir/pci95-bios-read-host-test" ||
        die "PCI95 BIOS transport regression failed"
}

