# Optional 16-bit DOS MZ .EXE. Never executes it on the build host.
# Requires the pinned OpenWatcom DOS compiler/linker/runtime library.
dos_probe_build() {
    watcom_check
    [ -x "$watcom_bin_dir/wcc" ] ||
        die "OpenWatcom 16-bit DOS compiler missing: $watcom_bin_dir/wcc"
    [ -d "$watcom_root/lib286/dos" ] ||
        die "OpenWatcom 16-bit DOS runtime missing: $watcom_root/lib286/dos"
    out_dir="$root/.build/dos-pci"
    [ ! -L "$root/.build" ] && [ ! -L "$out_dir" ] ||
        die "DOS output path must not be a symlink"
    [ ! -e "$out_dir" ] || [ -d "$out_dir" ] ||
        die "DOS output path exists but is not a directory"
    mkdir -p "$out_dir"
    # Do not leave a previous valid-looking EXE after a failed link.
    rm -f "$out_dir/WHPPROBE.EXE"
    (
        export WATCOM="$watcom_root"
        export INCLUDE="$watcom_root/h"
        export LIB="$watcom_root/lib286/dos"
        for source in pci_bios_read pci_bridge pci_config_report; do
            "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
                "-i=$root/drivers/bus/pci95" \
                "-fo=$out_dir/$source.obj" \
                "$root/drivers/bus/pci95/$source.c" ||
                die "DOS PCI source failed: $source.c"
        done
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/drivers/bus/pci95" \
            "-fo=$out_dir/pci_dos_memory.obj" \
            "$root/drivers/bus/pci95/pci_dos_memory.c" ||
            die "DOS PCI memory audit compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/drivers/bus/pci95" \
            "-fo=$out_dir/amd12_topology.obj" \
            "$root/drivers/bus/pci95/amd12_topology.c" ||
            die "DOS AMD12 PCIe topology compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/drivers/network/rtl8111e" \
            "-fo=$out_dir/identity.obj" \
            "$root/drivers/network/rtl8111e/identity.c" ||
            die "DOS RTL8111E identity compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/drivers/storage/fch_sata" \
            "-fo=$out_dir/sata_identity.obj" \
            "$root/drivers/storage/fch_sata/identity.c" ||
            die "DOS FCH SATA identity compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/drivers/usb" \
            "-fo=$out_dir/usb_pci_hci.obj" \
            "$root/drivers/usb/pci_hci.c" ||
            die "DOS USB PCI HCI identity compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/tools/dos" \
            "-fo=$out_dir/legacy_bios.obj" \
            "$root/tools/dos/legacy_bios.c" ||
            die "DOS legacy BIOS snapshot decoder compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/tools/dos" \
            "-fo=$out_dir/dos_version.obj" \
            "$root/tools/dos/dos_version.c" ||
            die "DOS version classification compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/tools/dos" \
            "-fo=$out_dir/memory_survey.obj" \
            "$root/tools/dos/memory_survey.c" || \
            die "DOS memory survey compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/tools/dos" \
            "-fo=$out_dir/probe_menu.obj" \
            "$root/tools/dos/probe_menu.c" || \
            die "DOS probe menu compilation failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/tools/probe" \
            "-fo=$out_dir/probe_scope.obj" \
            "$root/tools/probe/probe_scope.c" ||
            die "DOS probe scope compile failed"
        "$watcom_bin_dir/wcc" -zq -wx -bt=dos -ms \
            "-i=$root/tools/dos" \
            "-i=$root/drivers/usb" \
            "-i=$root/drivers/storage/fch_sata" \
            "-i=$root/drivers/bus/pci95" \
            "-i=$root/drivers/network/rtl8111e" \
            "-fo=$out_dir/whpprobe.obj" \
            "$root/tools/dos/whpprobe.c" ||
            die "DOS hardware probe compilation failed"
        "$watcom_bin_dir/wlink" "system dos" "option quiet" "option stack=8192" \
            "libpath $watcom_root/lib286/dos" \
            "file $out_dir/pci_bios_read.obj" \
            "file $out_dir/pci_bridge.obj" \
            "file $out_dir/pci_config_report.obj" \
            "file $out_dir/pci_dos_memory.obj" \
            "file $out_dir/amd12_topology.obj" \
            "file $out_dir/identity.obj" \
            "file $out_dir/sata_identity.obj" \
            "file $out_dir/usb_pci_hci.obj" \
            "file $out_dir/dos_version.obj" \
            "file $out_dir/legacy_bios.obj" \
            "file $out_dir/whpprobe.obj" \
            "file $out_dir/probe_menu.obj" \
            "file $out_dir/probe_scope.obj" \
            "file $out_dir/memory_survey.obj" \
            "name $out_dir/WHPPROBE.EXE" ||
            die "DOS hardware probe MZ EXE linking failed"
    )
    [ -s "$out_dir/WHPPROBE.EXE" ] ||
        die "DOS probe linker did not produce WHPPROBE.EXE"
    need python3
    python3 "$root/tools/verify_dos_mz.py" "$out_dir/WHPPROBE.EXE" ||
        die "DOS PCI output did not pass MZ structural preflight"
    printf '%s\n' "WHP-Drivers: DOS hardware probe built ($out_dir/WHPPROBE.EXE; real hardware NOT tested)"
}

