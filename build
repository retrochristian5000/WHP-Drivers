#!/bin/sh
# WHP-Drivers: native WHP LLVM bootstrap and x86 COFF compiler smoke test.
set -eu

root=$(CDPATH= cd "$(dirname "$0")" && pwd)
llvm_root="$root/toolchains/llvm-project"
llvm_src="$llvm_root/llvm"
build_dir=${WHP_LLVM_BUILD_DIR:-"$root/.build/llvm-native"}
bin_dir=${WHP_LLVM_BIN_DIR:-"$build_dir/bin"}

die() {
    printf '%s\n' "WHP-Drivers: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "missing required program: $1"
}

check_source() {
    need git
    [ -f "$llvm_src/CMakeLists.txt" ] ||
        die "missing LLVM submodule: git submodule update --init toolchains/llvm-project"
    pinned=$(git -C "$root" rev-parse HEAD:toolchains/llvm-project 2>/dev/null) ||
        die "cannot read pinned LLVM revision"
    actual=$(git -C "$llvm_root" rev-parse HEAD 2>/dev/null) ||
        die "cannot read LLVM checkout revision"
    [ "$pinned" = "$actual" ] ||
        die "LLVM checkout differs from pinned revision ($actual != $pinned)"
}

check_tools() {
    check_source
    for tool in clang clang++ lld-link llvm-ar llvm-nm llvm-ranlib \
                llvm-objcopy llvm-objdump llvm-readobj llvm-strip
    do
        [ -x "$bin_dir/$tool" ] ||
            die "missing $bin_dir/$tool (run ./build bootstrap or set WHP_LLVM_BIN_DIR)"
    done
    "$bin_dir/clang" --version
}

bootstrap() {
    check_source
    need cmake
    need ninja
    jobs=${WHP_LLVM_JOBS:-2}
    case "$jobs" in
        ''|0|*[!0-9]*) die "WHP_LLVM_JOBS must be a positive integer" ;;
    esac
    cmake -S "$llvm_src" -B "$build_dir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        '-DLLVM_ENABLE_PROJECTS=clang;lld' \
        -DLLVM_TARGETS_TO_BUILD=X86 \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_BENCHMARKS=OFF
    cmake --build "$build_dir" --parallel "$jobs" --target \
        clang lld llvm-ar llvm-nm llvm-ranlib llvm-objcopy \
        llvm-objdump llvm-readobj llvm-strip
    bin_dir="$build_dir/bin"
    check_tools
}

smoke() {
    check_tools
    out_dir="$build_dir/whp-tests"
    mkdir -p "$out_dir"
    "$bin_dir/clang" --target=i386-pc-windows-msvc \
        -std=c11 -ffreestanding -fno-builtin -fno-stack-protector \
        -Wall -Wextra -Werror -c \
        "$root/tests/i386-abi-probe.c" -o "$out_dir/i386-abi-probe.obj"
    "$bin_dir/llvm-readobj" --file-headers "$out_dir/i386-abi-probe.obj" |
        grep -q 'Machine: IMAGE_FILE_MACHINE_I386' ||
        die "COFF i386 machine-type verification failed"
    printf '%s\n' "WHP-Drivers: i386 Windows COFF compiler smoke test passed"
}

case "${1:-}" in
    bootstrap) bootstrap ;;
    check) check_tools ;;
    smoke) smoke ;;
    verify-vxd)
        [ "$#" -eq 2 ] || die "usage: ./build verify-vxd <file.vxd>"
        need python3
        exec python3 "$root/tools/verify_vxd.py" --dynamic "$2"
        ;;
    test-format)
        [ "$#" -eq 1 ] || die "usage: ./build test-format"
        need python3
        cd "$root"
        exec python3 -m unittest discover -s tests -p 'test_vxd_format.py'
        ;;
    *) printf 'Usage: %s {bootstrap|check|smoke|verify-vxd <file>|test-format}\n' "$0" >&2; exit 2 ;;
esac
